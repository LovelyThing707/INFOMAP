# 値を入れたファイルは .env.local として置くこと（.gitignore 済み）。

# 地図タイル（CARTO）のキー。未設定でも地図は出るが「API KEY REQUIRED」の透かしが入る。
# 無料・アカウント不要・即発行（月500万タイルまで）: https://carto.com/basemaps/apikey
EXPO_PUBLIC_CARTO_KEY=

# Supabase を繋ぐときだけ設定する。両方揃ったときにだけ Supabase を見る。
# 未設定ならローカル（AsyncStorage）実装で動く。
#
# 入れるのはクライアント用の公開鍵。いまの現行形式は sb_publishable_ で、
# 旧 anon（JWT）は2026年末に廃止予定。どちらでも動く。
# sb_secret_ / service_role は絶対に入れない。RLS を無視する全権の鍵。
#
# 公開鍵はアプリのバンドルに埋まる前提のもので、隠せない。守っているのは
# 鍵ではなくDB側の権限と行レベル制限（npm run verify:schema で実測できる）。
#
# 両方揃うと data 層が Supabase 実装に切り替わる（片方だけでは繋がない）。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
